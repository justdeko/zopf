root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = off

# Compose functions are PascalCase by convention
ktlint_function_naming_ignore_when_annotated_with = Composable

# This codebase names constants PascalCase (ArrowSize, TitleBarHeight, ...)
ktlint_standard_property-naming = disabled

[**/main.kt]
# The JVM entry point is conventionally lowercase (compiles to MainKt)
ktlint_standard_filename = disabled
